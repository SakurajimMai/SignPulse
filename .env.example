# Telegram API 凭证（可选）
# 如果不设置，将使用内置默认配置；也可以在系统设置中配置
# 如需使用自己的凭证，从 https://my.telegram.org 获取
# TG_API_ID=your_api_id_here
# TG_API_HASH=your_api_hash_here

# 应用密钥（必须！）
# 使用随机字符串，例如: python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_SECRET_KEY=your_secret_key_here

# 可选：首次启动时创建管理员账号使用的密码
# 如果不设置，系统会生成一次性随机密码并写入数据目录下的 .admin_bootstrap_password
# 强烈建议在首次部署时设置此变量
# ADMIN_PASSWORD=change_me

# 可选：允许跨域访问后端 API 的前端来源，逗号分隔
# APP_CORS_ALLOW_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# 可选配置
PORT=8080
# 容器内数据目录，须与 compose volumes 的 target 一致。
# 宿主机挂载请保持相对路径 ./data，不要写成系统根目录 /data，
# 也不要把本变量填进 volumes 左侧。
APP_DATA_DIR=/data

# 可选：云 MariaDB / MySQL / Postgres。不设则用 ./data/db.sqlite
# 密码若含 @ # : / 等字符，请先做 URL 编码。
# APP_DATABASE_URL=mysql+pymysql://user:pass@host:3306/tg_signpulse?charset=utf8mb4
# 需要 TLS 时在 URL 后加 &ssl=true，或按云厂商提供 ssl_ca。
# APP_DATABASE_URL=mysql+pymysql://user:pass@host:3306/tg_signpulse?charset=utf8mb4&ssl=true

# 面板 2FA TOTP 时间窗口容差（默认 0，仅当前 30s；可设 1 表示允许前后各 1 个窗口）
# APP_TOTP_VALID_WINDOW=1

# Telegram Session 模式（默认 file）
# TG_SESSION_MODE=file
# TG_GLOBAL_CONCURRENCY=1

# 任务执行超时（秒，默认 300 即 5 分钟）
# SIGN_TASK_EXECUTION_TIMEOUT=300

# 漫画采集子模块。采集号使用 /accounts 里的 SignPulse 账号。
MANGA_ENABLED=false
# 以下为容器内路径；Compose 宿主机目录仍是 ./data
MANGA_DATA_DIR=/data
MANGA_DATABASE_URL=sqlite:////data/tg_manga.db
# 漫画库也可单独指向云 MariaDB（建议与面板库分开）
# MANGA_DATABASE_URL=mysql+asyncmy://user:pass@host:3306/tg_manga?charset=utf8mb4
MANGA_TEMP_DIR=/data/tmp/manga
MANGA_TELEGRAM_ACCOUNT=
MANGA_HISTORY_BACKFILL_LIMIT=1500
MANGA_SOURCE_CHATS=
# JSON 列表：[{"channel":"@chan","discussion":"@group","ingest_mode":"auto"}]
# ingest_mode: auto | discussion | telegraph；讨论群留空且 auto 时走 Telegraph
# MANGA_SOURCE_BINDINGS=
MANGA_ALLOWED_SENDER_IDS=
MANGA_DISCUSSION_ONLY=true
MANGA_IGNORE_USER_COMMENTS=true
MANGA_ACCEPT_IMAGE_DOCUMENTS=true
MANGA_CHAPTER_IDLE_SECONDS=8
# 讨论帖同一话最长等待秒数（默认 900）。上传慢也不会提前收口。
MANGA_CHAPTER_REPLY_IDLE_SECONDS=900
# 单话最大页数（面板保存上限 10000；长篇 IF 线建议 2000）
MANGA_CHAPTER_MAX_PAGES=2000

# 兼容旧项目的 TELEGRAM_* / TG_* 配置名；使用 MANGA_* 时优先级更高。
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
# TELEGRAM_SESSION_FILE 同样是容器内路径，对应宿主机 ./data/sessions/
# TG_SOURCE_CHATS=
# TG_ALLOWED_SENDER_IDS=
# TG_DISCUSSION_ONLY=true
# IGNORE_USER_COMMENTS=true

# ImgBed / 图片托管
CFBED_UPLOAD_URL=
CFBED_AUTH_CODE=
CFBED_API_TOKEN=
CFBED_EXTRA_QUERY=
CFBED_PUBLIC_BASE=
CFBED_FILE_FIELD=file
CFBED_RETRY_DELAY_SECONDS=30

# AnimeStream (/root/code/hentaiworkers) 发布接口
SITE_PUBLISH_URL=
SITE_PUBLISH_SECRET=

# 采集入库后转发到自己的频道（也可在面板漫画页配置）
# MANGA_OUTBOUND_ENABLED=0
# MANGA_OUTBOUND_CHANNEL=-1002085070183
# MANGA_OUTBOUND_PREVIEW_COUNT=4
# MANGA_OUTBOUND_BUTTON_TEXT=点击阅读
# MANGA_OUTBOUND_SITE_BASE=https://www.ixacg.de
# MANGA_OUTBOUND_BOT_TOKEN=
# MANGA_OUTBOUND_FORWARD_VIDEOS=1
# MANGA_OUTBOUND_VIDEO_BLOCK_KEYWORDS=
# MANGA_OUTBOUND_VIDEO_ALLOW_KEYWORDS=
# MANGA_OUTBOUND_VIDEO_MIN_SECONDS=0
# MANGA_OUTBOUND_VIDEO_MAX_SECONDS=0
